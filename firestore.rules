rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Whitelist of faculty/admin UIDs — documents created manually in the
    // Firebase Console after you create each faculty member's account.
    // e.g. admins/{uid} => { name: "Suraj Bhoite", email: "..." }
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false; // manage only via the Firebase Console
    }

    // Notes metadata
    match /notes/{noteId} {
      allow read: if resource.data.isActive == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Student access logs — students can create their own access record
    // (this is how "record access" happens without a login), but can never
    // read, edit, or delete logs. Only admins can read them.
    match /noteAccessLogs/{logId} {
      allow create: if request.resource.data.studentName is string &&
                      request.resource.data.studentName.size() > 0 &&
                      request.resource.data.studentName.size() < 100 &&
                      request.resource.data.className is string &&
                      request.resource.data.noteId is string;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Shared subject catalog — readable by students, editable by admins.
    match /settings/{settingId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if false;
    }
  }
}
